@startuml natural_test
left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam wrapWidth 140
skinparam monochrome true
skinparam shadowing false

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontStyle       bold
    FontSize        12
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontSize        10.5
    BorderThickness 1.2
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontStyle       bold
    FontSize        13
    BorderThickness 1.8
}

skinparam arrow {
    Color     #000000
    FontSize  9.5
}

:Tamu: as Tamu
:Admin: as Admin
:Midtrans\n(Payment Gateway): as Midtrans

rectangle "Sistem Reservasi Rama Homestay" {

    (Login Tamu)                                 as UC01
    (Logout Tamu)                                as UC02
    (Registrasi Akun Tamu)                       as UC03
    (Melihat Katalog dan\nMemfilter Kamar)       as UC04
    (Melihat Detail Kamar)                       as UC05
    (Melihat Ulasan Tamu)                        as UC06
    (Melakukan\nReservasi Kamar)                 as UC07
    (Memantau Status\nReservasi)                 as UC08
    (Membatalkan Reservasi\n[status: pending])   as UC09
    (Memberi Testimoni)                          as UC10
    (Mengelola Profil)                           as UC11
    (Membayar Reservasi)                         as UC12

    (Menambah Data Kamar)                        as UC23
    (Mengubah Data Kamar)                        as UC24
    (Menghapus Data Kamar)                       as UC25

    (Memeriksa Ketersediaan\nKamar)              as UC13
    (Memvalidasi Tanggal\nCheck-in/Check-out)    as UC14
    (Menghitung Biaya\n[Pajak dan Layanan])      as UC15
    (Membuat Kode Booking\nUnik)                 as UC16

    (Memperbarui Status\nReservasi)              as UC27
    (Mengekspor Laporan\nke PDF)                 as UC30

    (Memperbarui Status\nReservasi Otomatis)     as UC33
    (Memproses Pembayaran\n[Midtrans Snap])      as UC17
    (Menerima Notifikasi\nStatus Pembayaran)     as UC18

    (Login Admin)                                as UC19
    (Logout Admin)                               as UC20
    (Melihat Dashboard\nStatistik)               as UC21
    (Mengelola Data Kamar)                       as UC22
    (Melihat Daftar dan\nDetail Reservasi)       as UC26
    (Melihat Kalender\nKetersediaan Kamar)       as UC28
    (Membuat Laporan\nReservasi)                 as UC29
    (Melihat Data Tamu)                          as UC31
    (Moderasi Testimoni)                         as UC32

}

' Asosiasi Tamu
Tamu -- UC01
Tamu -- UC02
Tamu -- UC03
Tamu -- UC04
Tamu -- UC05
Tamu -- UC06
Tamu -- UC07
Tamu -- UC08
Tamu -- UC09
Tamu -- UC10
Tamu -- UC11
Tamu -- UC12

' Asosiasi Admin
UC19 -- Admin
UC20 -- Admin
UC21 -- Admin
UC22 -- Admin
UC26 -- Admin
UC28 -- Admin
UC29 -- Admin
UC31 -- Admin
UC32 -- Admin

' Asosiasi Midtrans
UC17 -- Midtrans
UC18 -- Midtrans

' Relasi include
UC07 .> UC13 : <<include>>
UC07 .> UC14 : <<include>>
UC07 .> UC15 : <<include>>
UC07 .> UC16 : <<include>>
UC12 .> UC17 : <<include>>
UC33 .> UC18 : <<include>>

' Relasi extend
UC09 .> UC08 : <<extend>>
UC23 .> UC22 : <<extend>>
UC24 .> UC22 : <<extend>>
UC25 .> UC22 : <<extend>>
UC27 .> UC26 : <<extend>>
UC30 .> UC29 : <<extend>>

@enduml
