@startuml elegant_test2
left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam wrapWidth 140
skinparam monochrome true
skinparam shadowing false

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontStyle       bold
    FontSize        12
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontSize        10.5
    BorderThickness 1.2
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontStyle       bold
    FontSize        13
    BorderThickness 1.8
}

skinparam arrow {
    Color     #000000
    FontSize  9.5
}

:Tamu: as Tamu
:Admin: as Admin
:Midtrans\n(Payment Gateway): as Midtrans

rectangle "Sistem Reservasi Rama Homestay" {

    together {
        (Login Tamu)                                 as UC01
        (Logout Tamu)                                as UC02
        (Registrasi Akun Tamu)                       as UC03
        (Melihat Katalog dan\nMemfilter Kamar)       as UC04
        (Melihat Detail Kamar)                       as UC05
        (Melihat Ulasan Tamu)                        as UC06
        (Melakukan\nReservasi Kamar)                 as UC07
        (Memantau Status\nReservasi)                 as UC08
        (Membatalkan Reservasi\n[status: pending])   as UC09
        (Memberi Testimoni)                          as UC10
        (Mengelola Profil)                           as UC11
        (Membayar Reservasi)                         as UC12
    }

    together {
        (Menambah Data Kamar)                        as UC23
        (Mengubah Data Kamar)                        as UC24
        (Menghapus Data Kamar)                       as UC25

        (Memeriksa Ketersediaan\nKamar)              as UC13
        (Memvalidasi Tanggal\nCheck-in/Check-out)    as UC14
        (Menghitung Biaya\n[Pajak dan Layanan])      as UC15
        (Membuat Kode Booking\nUnik)                 as UC16

        (Memperbarui Status\nReservasi)              as UC27
        (Mengekspor Laporan\nke PDF)                 as UC30

        (Memperbarui Status\nReservasi Otomatis)     as UC33
        (Menerima Notifikasi\nStatus Pembayaran)     as UC18
        (Memproses Pembayaran\n[Midtrans Snap])      as UC17
    }

    together {
        (Login Admin)                                as UC19
        (Logout Admin)                               as UC20
        (Melihat Dashboard\nStatistik)               as UC21
        (Mengelola Data Kamar)                       as UC22
        (Melihat Daftar dan\nDetail Reservasi)       as UC26
        (Melihat Kalender\nKetersediaan Kamar)       as UC28
        (Membuat Laporan\nReservasi)                 as UC29
        (Melihat Data Tamu)                          as UC31
        (Moderasi Testimoni)                         as UC32
    }

    ' Vertikal Kolom 1 (Top -> Down)
    UC01 -[hidden]right-> UC02
    UC02 -[hidden]right-> UC03
    UC03 -[hidden]right-> UC04
    UC04 -[hidden]right-> UC05
    UC05 -[hidden]right-> UC06
    UC06 -[hidden]right-> UC07
    UC07 -[hidden]right-> UC08
    UC08 -[hidden]right-> UC09
    UC09 -[hidden]right-> UC10
    UC10 -[hidden]right-> UC11
    UC11 -[hidden]right-> UC12

    ' Vertikal Kolom 2 (Top -> Down reversed chain)
    UC17 -[hidden]right-> UC18
    UC18 -[hidden]right-> UC33
    UC33 -[hidden]right-> UC30
    UC30 -[hidden]right-> UC27
    UC27 -[hidden]right-> UC16
    UC16 -[hidden]right-> UC15
    UC15 -[hidden]right-> UC14
    UC14 -[hidden]right-> UC13
    UC13 -[hidden]right-> UC25
    UC25 -[hidden]right-> UC24
    UC24 -[hidden]right-> UC23

    ' Vertikal Kolom 3 (Top -> Down reversed chain)
    UC32 -[hidden]right-> UC31
    UC31 -[hidden]right-> UC29
    UC29 -[hidden]right-> UC28
    UC28 -[hidden]right-> UC26
    UC26 -[hidden]right-> UC22
    UC22 -[hidden]right-> UC21
    UC21 -[hidden]right-> UC20
    UC20 -[hidden]right-> UC19

    ' Horizontal Kolom
    UC01 -[hidden]down-> UC23
    UC23 -[hidden]down-> UC19
}

' Asosiasi Tamu
Tamu -- UC01
Tamu -- UC02
Tamu -- UC03
Tamu -- UC04
Tamu -- UC05
Tamu -- UC06
Tamu -- UC07
Tamu -- UC08
Tamu -- UC09
Tamu -- UC10
Tamu -- UC11
Tamu -- UC12

' Asosiasi Admin
UC19 -- Admin
UC20 -- Admin
UC21 -- Admin
UC22 -- Admin
UC26 -- Admin
UC28 -- Admin
UC29 -- Admin
UC31 -- Admin
UC32 -- Admin

' Asosiasi Midtrans
UC17 -- Midtrans
UC18 -- Midtrans

' Relasi include
UC07 .> UC13 : <<include>>
UC07 .> UC14 : <<include>>
UC07 .> UC15 : <<include>>
UC07 .> UC16 : <<include>>
UC12 .> UC17 : <<include>>
UC33 .> UC18 : <<include>>

' Relasi extend
UC09 .> UC08 : <<extend>>
UC23 .> UC22 : <<extend>>
UC24 .> UC22 : <<extend>>
UC25 .> UC22 : <<extend>>
UC27 .> UC26 : <<extend>>
UC30 .> UC29 : <<extend>>

@enduml
